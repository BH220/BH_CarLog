<Window
    x:Class="BH_CarLog.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:BH_CarLog.Core;assembly=BH_CarLog.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:BH_CarLog.Views"
    xmlns:vm="clr-namespace:BH_CarLog.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1180"
    Height="760"
    MinWidth="1000"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Icon="pack://application:,,,/Assets/app.ico"
    Style="{StaticResource DarkWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--  기능 단축키  -->
        <KeyBinding
            Key="Insert"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="Ins" />
        <KeyBinding
            Key="F8"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F8" />
        <KeyBinding
            Key="Delete"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="Del" />
        <KeyBinding
            Key="F5"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F5" />
        <KeyBinding
            Key="F6"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F6" />
        <KeyBinding
            Key="F1"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F1" />
        <KeyBinding
            Key="F2"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F2" />
        <KeyBinding
            Key="Escape"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="ESC" />
        <!--  메뉴 단축키 (Ctrl + Shift + Key). 기존 WinForms 와 같은 키를 쓴다.  -->
        <KeyBinding
            Key="N"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.새메시지}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="O"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.주유}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="F"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.유지보수}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="C"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.소모품}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="T"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.교환주기}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="M"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.차량}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="H"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.가게}"
            Modifiers="Ctrl+Shift" />
        <!--  시스템 단축키 (Alt + Key)  -->
        <KeyBinding
            Key="R"
            Command="{Binding ExtendTimeCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="L"
            Command="{Binding LockScreenCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="O"
            Command="{Binding LogoutCommand}"
            Modifiers="Alt" />
    </Window.InputBindings>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  상단 타이틀 바  -->
            <Border
                Grid.Row="0"
                Padding="18,10"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="30"
                            Height="30"
                            Source="pack://application:,,,/Assets/Images/car.png" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                Style="{StaticResource TitleText}"
                                Text="BH Car Logs" />
                            <TextBlock Style="{StaticResource SubtitleText}" Text="주유 · 유지보수 · 소모품 · 차량 · 가게 통합 관리" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="연장하기"
                            Command="{Binding ExtendTimeCommand}"
                            IsEnabled="{Binding IsLoggedIn}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="자동 잠금 시간 연장 (Alt + R)">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/refresh.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Text="{Binding ContinueText}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="화면잠금"
                            Command="{Binding LockScreenCommand}"
                            IsEnabled="{Binding IsLoggedIn}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="화면잠금 (Alt + L)">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/lock.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="화면잠금" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="프로그램 종료"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="프로그램 종료">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/exit.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="프로그램 종료" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  기능 버튼 바  -->
            <Border
                Grid.Row="1"
                Padding="12,6"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  좌측: 데이터 편집 / 조회  -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="추가"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="Ins"
                            IsEnabled="{Binding Buttons.InsertEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_insert.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="추가 (Ins)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="수정"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F8"
                            IsEnabled="{Binding Buttons.UpdateEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_update.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="수정 (F8)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="삭제"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="Del"
                            IsEnabled="{Binding Buttons.DeleteEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_delete.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="삭제 (Del)" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="갱신"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F5"
                            IsEnabled="{Binding Buttons.RefreshEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_refresh.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="갱신 (F5)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="검색"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F6"
                            IsEnabled="{Binding Buttons.SearchEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_search.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="검색 (F6)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  우측 정렬: 화면별 추가 기능 / 닫기  -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Separator Visibility="{Binding Buttons.Custom1Visible, Converter={StaticResource BoolToVis}}" />
                        <Button
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F1"
                            Style="{StaticResource ToolButton}"
                            Visibility="{Binding Buttons.Custom1Visible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_view.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Buttons.Custom1Text}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F2"
                            Style="{StaticResource ToolButton}"
                            Visibility="{Binding Buttons.Custom2Visible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_view.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Buttons.Custom2Text}" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="화면닫기"
                            Command="{Binding CloseViewCommand}"
                            IsEnabled="{Binding Buttons.CloseEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_close.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="닫기 (ESC)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  본문: 좌측 메뉴 + 컨텐츠  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12,14"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="사용자 정보" />
                        <Border
                            Margin="0,0,0,18"
                            Padding="12"
                            Background="{StaticResource BgSurfaceBrush}"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding LoginUserText}" TextWrapping="Wrap" />

                                <!--
                                    차량 선택 (기존 frmMain 의 carSelect).
                                    주유·유지보수·소모품 화면은 모두 여기서 고른 차 기준으로 조회된다.
                                -->
                                <TextBlock
                                    Margin="0,12,0,5"
                                    FontSize="12"
                                    Style="{StaticResource MutedText}"
                                    Text="차량" />
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    IsEnabled="{Binding IsLoggedIn}"
                                    ItemsSource="{Binding CarContext.Cars}"
                                    SelectedItem="{Binding CarContext.SelectedCar, Mode=TwoWay}"
                                    Tag="차량 선택"
                                    ToolTip="선택한 차량의 기록만 표시됩니다." />

                                <Button
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding LogoutCommand}"
                                    Content="로그아웃 (Alt+O)"
                                    Style="{StaticResource LinkButton}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionText}" Text="메뉴 (Ctrl + Shift + 키)" />
                        <ItemsControl ItemsSource="{Binding Menus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.SelectMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding MenuId}"
                                        Style="{StaticResource MenuButton}"
                                        ToolTip="{Binding ShortcutText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="22"
                                                Height="22"
                                                Source="{Binding Icon}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Title}" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BgInputBrush}"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontFamily="{StaticResource MonoFont}"
                                                    FontSize="11"
                                                    Style="{StaticResource MutedText}"
                                                    Text="{Binding Shortcut}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="16">
                    <ContentControl Content="{Binding CurrentView}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasView, Converter={StaticResource InvBoolToVis}}">
                        <Image
                            Width="72"
                            Height="72"
                            Opacity="0.3"
                            Source="pack://application:,,,/Assets/Images/car.png" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Style="{StaticResource SubtitleText}"
                            Text="좌측 메뉴를 선택하세요" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            Style="{StaticResource SubtitleText}"
                            Text="Ctrl + Shift + N / O / F / C / T / M / H" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  상태바  -->
            <Border
                Grid.Row="3"
                Padding="14,5"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding StatusText}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,24,0"
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding UserInfoText}" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding NowText}" />
                </Grid>
            </Border>
        </Grid>

        <!--  로그인 오버레이 (로그인 전 / 화면 잠금)  -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
            <views:LoginView DataContext="{Binding Login}" />
        </Grid>
    </Grid>
</Window>
