<Window
    x:Class="BH_CarLog.Views.Common.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Common"
    Title="{Binding Title}"
    Width="900"
    Height="680"
    MinWidth="560"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=vm:ImageViewerViewModel}"
    helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
    ResizeMode="CanResize"
    Style="{StaticResource DarkDialog}"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="F" Command="{Binding FitCommand}" />
        <KeyBinding Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="L" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="R" Command="{Binding RotateRightCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="16">
        <!--  도구 모음: 축소 | 배율 | 확대 | 창 맞춤 | 실제 크기 | 회전  -->
        <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding ZoomOutCommand}"
                    Content="축소 (-)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="축소: - 키 또는 마우스 휠 아래로" />
                <Border
                    MinWidth="96"
                    Padding="6,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        Text="{Binding ZoomText}"
                        ToolTip="현재 배율 · 회전 각도" />
                </Border>
                <Button
                    Command="{Binding ZoomInCommand}"
                    Content="확대 (+)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="확대: + 키 또는 마우스 휠 위로" />
                <Separator />
                <Button
                    Command="{Binding FitCommand}"
                    Content="창 맞춤 (F)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="창 크기에 맞춰 전체 보기" />
                <Button
                    Command="{Binding ActualSizeCommand}"
                    Content="실제 크기 (1)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="100% (이미지 1픽셀 = 화면 1픽셀)" />
                <Separator />
                <Button
                    Command="{Binding RotateLeftCommand}"
                    Content="↺ 왼쪽 회전 (L)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="시계 반대 방향으로 90° 회전" />
                <Button
                    Command="{Binding RotateRightCommand}"
                    Content="↻ 오른쪽 회전 (R)"
                    Style="{StaticResource ToolButton}"
                    ToolTip="시계 방향으로 90° 회전" />
            </StackPanel>
            <Button
                MinWidth="90"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="닫기"
                IsCancel="True" />
        </Grid>

        <!--  이미지 영역. 배율/회전은 LayoutTransform 으로 적용하고, 화면보다 크면 스크롤한다.  -->
        <Border
            Padding="4"
            Background="{StaticResource BgInputBrush}"
            CornerRadius="6">
            <ScrollViewer
                x:Name="Viewer"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                PreviewMouseWheel="Viewer_PreviewMouseWheel"
                ScrollChanged="Viewer_ScrollChanged"
                SizeChanged="Viewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <Image
                    Width="{Binding PixelWidth}"
                    Height="{Binding PixelHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Image.data, Converter={StaticResource BytesToImage}}"
                    Stretch="Fill">
                    <Image.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            <RotateTransform Angle="{Binding Angle}" />
                        </TransformGroup>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
