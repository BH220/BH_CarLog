<Window x:Class="BH_CarLog.Views.Common.ShopSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShopSelectViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="820"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <!--
        가게 입력란에서 친 글자가 여러 가게에 맞거나 하나도 없을 때 뜬다 (기존 BhSearchForm).
        검색어 상자에는 그 글자가 들어가 있고 목록은 걸러져 있다. 포커스는 그리드에 있어 ↑↓ 와 Enter 로 바로 고른다.
    -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="선택" Style="{StaticResource AccentButton}" Command="{Binding SelectCommand}" MinWidth="90" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="KeywordBox"
                     Style="{StaticResource SearchTextBox}"
                     Tag="가게명 · 대표자명으로 검색"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="KeywordBox_PreviewKeyDown">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource SubtitleText}"
                       Text="↑↓ 로 고르고 Enter 또는 더블클릭으로 선택합니다. 검색어를 고치면 목록이 바로 걸러지고, ↓ 를 누르면 목록으로 내려갑니다." />
        </StackPanel>

        <DataGrid x:Name="ResultGrid"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  helpers:DataGridBehavior.RowDoubleClickCommand="{Binding SelectCommand}"
                  helpers:DataGridBehavior.ScrollSelectionIntoView="True">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <!--  항목: CarShopInfo (기존 BHS_Shops 컬럼: 구분/가게명/대표자/주소)  -->
                <DataGridTextColumn Header="구분" Binding="{Binding shop_type}" Width="80" ElementStyle="{StaticResource CenterCellText}" />
                <DataGridTextColumn Header="가게명" Binding="{Binding name}" Width="1.5*" />
                <DataGridTextColumn Header="대표자" Binding="{Binding ceo}" Width="90" />
                <DataGridTextColumn Header="주소" Binding="{Binding address}" Width="2*" ElementStyle="{StaticResource MutedCellText}" />
                <DataGridTextColumn Header="전화" Binding="{Binding tel}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
