<Window x:Class="BH_CarLog.Views.Common.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:conv="clr-namespace:BH_CarLog.Converters"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MessageViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,16,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Question">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding IconText}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       LineHeight="20"
                       MinHeight="40" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="확인"
                    Style="{StaticResource AccentButton}"
                    MinWidth="88"
                    IsDefault="True"
                    Command="{Binding OkCommand}"
                    Visibility="{Binding IsOkVisible, Converter={StaticResource BoolToVis}}" />
            <Button Content="예"
                    Style="{StaticResource AccentButton}"
                    MinWidth="88"
                    IsDefault="True"
                    Command="{Binding YesCommand}"
                    Visibility="{Binding IsYesNoVisible, Converter={StaticResource BoolToVis}}" />
            <Button Content="아니오"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Command="{Binding NoCommand}"
                    Visibility="{Binding IsYesNoVisible, Converter={StaticResource BoolToVis}}" />
            <Button Content="취소"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
