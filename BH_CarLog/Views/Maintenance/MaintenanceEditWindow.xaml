<Window x:Class="BH_CarLog.Views.Maintenance.MaintenanceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:common="clr-namespace:BH_CarLog.Views.Common"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Maintenance"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MaintenanceEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="600"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
        helpers:EnterNavigation.IsEnabled="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <!--  IsReadOnly(상세 보기) 면 입력란은 읽기 전용, 콤보는 조작 불가, 저장 버튼은 감춘다. 글자색은 그대로 두어 내용이 잘 보이게 한다.  -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="유지보수 정보">
                <!--  오른쪽 라벨 폭을 RightLabel 그룹으로 맞춰 모든 줄의 입력란 좌우 경계가 같은 위치에 오게 한다.  -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="차량" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" DisplayMemberPath="DisplayName" Tag="차량 선택"
                                  IsHitTestVisible="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                  Focusable="{Binding IsReadOnly, Converter={StaticResource InverseBool}}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RequiredLabel}" MinWidth="0"><Run Text="유형" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="NmCode" Tag="유형 선택"
                                  IsHitTestVisible="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                  Focusable="{Binding IsReadOnly, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Style="{StaticResource RequiredLabel}"><Run Text="가게" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  가게는 콤보가 아니라 가게명 일부 + Enter 로 찾는다 (기존 BhSearchItem). 읽기 전용은 ViewModel 의 Shop.IsReadOnly 가 맡는다.  -->
                        <common:ShopPickerControl DataContext="{Binding Shop}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RequiredLabel}" MinWidth="0"><Run Text="날짜" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                        <!--  유지보수일(mataintenance_at). 상세 보기에서는 달력 대신 읽기 전용 텍스트로 보여 준다.  -->
                        <DatePicker Grid.Column="3" SelectedDate="{Binding MaintenanceAt}"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}" />
                        <TextBox Grid.Column="3" IsReadOnly="True"
                                 Text="{Binding MaintenanceAt, Mode=OneWay, Converter={StaticResource DateFmt}}"
                                 Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource RequiredLabel}"><Run Text="주행거리" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="9"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 helpers:NumericTextBoxBehavior.IsNumericOnly="True"
                                 helpers:FocusExtension.IsFocused="{Binding IsMileageFocused}"
                                 ToolTip="계기판 적산 거리(㎞)" />
                        <TextBlock Grid.Column="2" Text="금액" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="9"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 helpers:NumericTextBoxBehavior.IsNumericOnly="True" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="내용" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource MultilineTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             MinHeight="80"
                             IsReadOnly="{Binding IsReadOnly}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="영수증 이미지" Margin="0">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
