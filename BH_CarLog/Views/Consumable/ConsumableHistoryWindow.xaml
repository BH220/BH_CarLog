<Window x:Class="BH_CarLog.Views.Consumable.ConsumableHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Consumable"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConsumableHistoryViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        ResizeMode="CanResize"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <!--  두 표 모두 행 더블클릭 = 유지보수 기록 상세(읽기 전용). 연결/해제는 각 표 아래 버튼으로만 한다.  -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TitleText}" Text="{Binding ConsumableName}" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource SubtitleText}" Text="{Binding CycleText}" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  연결된 교체 이력  -->
            <GroupBox Grid.Row="0" Header="교체 이력">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SubtitleText}"
                                   Text="이 소모품을 교체한 유지보수 기록입니다. 행을 더블클릭하면 내용을 상세로 봅니다." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="상세" Command="{Binding ShowHistoryDetailCommand}" MinWidth="90" />
                            <Button Content="연결 해제" Style="{StaticResource DangerButton}" Command="{Binding UnlinkCommand}" MinWidth="100" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Histories}"
                              SelectedItem="{Binding SelectedHistory}"
                              helpers:DataGridBehavior.RowDoubleClickCommand="{Binding ShowHistoryDetailCommand}"
                              helpers:DataGridBehavior.ScrollSelectionIntoView="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="날짜" Binding="{Binding MaintenanceAt, Converter={StaticResource DateFmt}}" Width="100" ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="유형" Binding="{Binding mataintenance_type}" Width="80" ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="가게명" Binding="{Binding ShopName}" Width="1.2*" />
                            <DataGridTextColumn Header="주행거리" Binding="{Binding mileage, StringFormat={}{0:#,0}}" Width="100" ElementStyle="{StaticResource RightCellText}" />
                            <DataGridTextColumn Header="금액" Binding="{Binding amount, StringFormat={}{0:#,0}}" Width="100" ElementStyle="{StaticResource RightCellText}" />
                            <DataGridTextColumn Header="내용" Binding="{Binding note}" Width="2*" ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Border Grid.Row="1" Style="{StaticResource HDivider}" Margin="0,10" />

            <!--  연결 후보: 이 차의 유지보수 기록 중 이 소모품의 교체이력이 아닌 것 (다른 소모품에 이어 둔 기록은 남긴다)  -->
            <GroupBox Grid.Row="2" Header="연결할 유지보수 기록" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SubtitleText}"
                                   Text="이 소모품의 교체이력으로 등록된 기록은 여기에 보이지 않습니다. 연결을 해제하면 다시 나타납니다." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="상세" Command="{Binding ShowCandidateDetailCommand}" MinWidth="90" />
                            <Button Content="이력으로 연결" Style="{StaticResource AccentButton}" Command="{Binding LinkCommand}" MinWidth="110" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate}"
                              helpers:DataGridBehavior.RowDoubleClickCommand="{Binding ShowCandidateDetailCommand}"
                              helpers:DataGridBehavior.ScrollSelectionIntoView="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="날짜" Binding="{Binding mataintenance_at, Converter={StaticResource DateFmt}}" Width="100" ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="유형" Binding="{Binding mataintenance_type}" Width="80" ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="가게명" Binding="{Binding ShopName}" Width="1.2*" />
                            <DataGridTextColumn Header="주행거리" Binding="{Binding mileage, StringFormat={}{0:#,0}}" Width="100" ElementStyle="{StaticResource RightCellText}" />
                            <DataGridTextColumn Header="금액" Binding="{Binding amount, StringFormat={}{0:#,0}}" Width="100" ElementStyle="{StaticResource RightCellText}" />
                            <DataGridTextColumn Header="내용" Binding="{Binding note}" Width="2*" ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
