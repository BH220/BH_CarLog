<Window x:Class="BH_CarLog.Views.Consumable.ConsumableEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Consumable"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConsumableEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="520"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
        helpers:EnterNavigation.IsEnabled="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="소모품 정보" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="차량" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}"
                              DisplayMemberPath="DisplayName" Tag="차량 선택" />

                    <TextBlock Grid.Row="1" Style="{StaticResource RequiredLabel}"><Run Text="항목명" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             helpers:FocusExtension.IsFocused="{Binding IsNameFocused}"
                             ToolTip="예: 엔진오일, 에어컨필터, 타이어" />

                    <TextBlock Grid.Row="2" Text="관리주기(일)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="9"
                             helpers:NumericTextBoxBehavior.IsNumericOnly="True"
                             ToolTip="비워 두면 날짜 기준 주기를 쓰지 않습니다." />

                    <TextBlock Grid.Row="3" Text="관리주기(㎞)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="9"
                             helpers:NumericTextBoxBehavior.IsNumericOnly="True"
                             ToolTip="비워 두면 주행거리 기준 주기를 쓰지 않습니다." />
                </Grid>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
