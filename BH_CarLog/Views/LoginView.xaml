<UserControl
    x:Class="BH_CarLog.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_CarLog.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <!--
        로그인 / 화면잠금 해제 공용 화면.
        좌측 인디고 패널(제품 + 기능 미리보기) + 우측 흰 입력 폼의 2단 구성이며,
        뒤 메인 화면이 비치지 않게 배경을 불투명하게 덮는다.
    -->
    <UserControl.Resources>
        <!--  좌측 패널(인디고) 위에 올라가는 글자  -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PanelSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PanelItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  아이콘이 남보라 위에서 묻히지 않게 반투명 흰 타일에 올린다.  -->
        <Style x:Key="PanelIconTile" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  입력 칸. 높이를 고정하면 글자가 잘리므로 MinHeight + 넉넉한 Padding 으로 둔다.  -->
        <Style
            x:Key="LoginTextBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style
            x:Key="LoginPasswordBox"
            BasedOn="{StaticResource {x:Type PasswordBox}}"
            TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPanelBrush}">
        <Grid
            Width="800"
            Height="470"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <!--
                그림자는 빈 Border 에만 걸어 뒤에 깐다.
                Effect 가 걸린 요소의 자식은 픽셀 스냅·ClearType 이 꺼져 글자가 흐려지거나 잘린다.
            -->
            <Border
                Margin="0,2,0,0"
                Background="{StaticResource BgSurfaceBrush}"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="26"
                        Direction="270"
                        Opacity="0.16"
                        ShadowDepth="5"
                        Color="#FF1F2328" />
                </Border.Effect>
            </Border>

            <Border
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ================= 좌측: 제품 패널 =================  -->
                    <Border Grid.Column="0" CornerRadius="10,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
                                <GradientStop Offset="1" Color="{StaticResource AccentPressedColor}" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid ClipToBounds="True">
                            <!--  계기판 눈금을 연상시키는 장식 링. 데이터가 아니라 배경 모양이다.  -->
                            <Ellipse
                                Width="360"
                                Height="360"
                                Margin="0,0,-150,-190"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Opacity="0.08"
                                Stroke="White"
                                StrokeThickness="26" />
                            <Ellipse
                                Width="250"
                                Height="250"
                                Margin="0,0,-95,-135"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Opacity="0.10"
                                Stroke="White"
                                StrokeThickness="18" />

                            <DockPanel Margin="30,34,30,26">
                                <!--  제품  -->
                                <StackPanel DockPanel.Dock="Top">
                                    <Border
                                        Width="46"
                                        Height="46"
                                        HorizontalAlignment="Left"
                                        Background="#33FFFFFF"
                                        CornerRadius="10">
                                        <Image
                                            Width="28"
                                            Height="28"
                                            Source="pack://application:,,,/Assets/Images/car.png" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        Style="{StaticResource PanelTitle}"
                                        Text="BH Car Logs" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource PanelSub}"
                                        Text="차계부 · 주유부터 정비까지 한 곳에" />
                                    <Border
                                        Height="1"
                                        Margin="0,22,0,0"
                                        Background="#33FFFFFF" />
                                </StackPanel>

                                <!--  버전  -->
                                <TextBlock
                                    DockPanel.Dock="Bottom"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="11"
                                    Foreground="#99FFFFFF"
                                    Text="{Binding VersionText}" />

                                <!--  기능 미리보기 (메인 화면의 좌측 메뉴와 같은 구성)  -->
                                <StackPanel Margin="0,22,0,0">
                                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                        <Border Style="{StaticResource PanelIconTile}">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Source="pack://application:,,,/Assets/Images/fuel.png" />
                                        </Border>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            Style="{StaticResource PanelItem}"
                                            Text="주유 기록과 연비" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                        <Border Style="{StaticResource PanelIconTile}">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Source="pack://application:,,,/Assets/Images/maintenance.png" />
                                        </Border>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            Style="{StaticResource PanelItem}"
                                            Text="정비 · 세차 · 구매 · 공기압" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                        <Border Style="{StaticResource PanelIconTile}">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Source="pack://application:,,,/Assets/Images/consumable.png" />
                                        </Border>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            Style="{StaticResource PanelItem}"
                                            Text="소모품 교체 주기" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PanelIconTile}">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Source="pack://application:,,,/Assets/Images/shop.png" />
                                        </Border>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            Style="{StaticResource PanelItem}"
                                            Text="차량 · 단골 가게" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!--  ================= 우측: 입력 폼 =================  -->
                    <DockPanel Grid.Column="1" Margin="40,34,40,22">
                        <!--  하단: 서버 주소 (원본에는 없지만 API 서버를 쓰므로 필요하다)  -->
                        <Grid DockPanel.Dock="Bottom">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="11"
                                Style="{StaticResource MutedText}"
                                Text="{Binding ServerAddressText}" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding OpenSettingsCommand}"
                                Content="서버 설정"
                                Style="{StaticResource LinkButton}"
                                ToolTip="API 서버 주소 설정" />
                        </Grid>

                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                Style="{StaticResource TitleText}"
                                Text="{Binding HeaderText}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource SubtitleText}"
                                Text="{Binding GuideText}" />

                            <TextBlock
                                Margin="0,26,0,6"
                                Style="{StaticResource FieldLabel}"
                                Text="아이디" />
                            <TextBox
                                helpers:FocusExtension.IsFocused="{Binding IsIdFocused}"
                                IsReadOnly="{Binding ReadOnly}"
                                Style="{StaticResource LoginTextBox}"
                                Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LoginCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock
                                Margin="0,14,0,6"
                                Style="{StaticResource FieldLabel}"
                                Text="비밀번호" />
                            <PasswordBox
                                helpers:FocusExtension.IsFocused="{Binding IsPasswordFocused}"
                                helpers:PasswordBoxHelper.BindPassword="True"
                                helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource LoginPasswordBox}">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LoginCommand}" />
                                </PasswordBox.InputBindings>
                            </PasswordBox>

                            <!--  오류 안내. 원본은 메시지 박스였지만 폼 안에서 바로 보여 준다.  -->
                            <Border
                                Margin="0,14,0,0"
                                Padding="10,7"
                                Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource DangerTextBrush}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  화면잠금 중에는 아이디 저장 설정을 건드리지 않는다. (기존 chkSaveInfo)  -->
                            <CheckBox
                                Margin="0,16,0,0"
                                Content="아이디 저장"
                                IsChecked="{Binding IsSaveId}"
                                IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                                ToolTip="다음 실행 때 아이디를 채워 둡니다. 비밀번호는 저장하지 않습니다." />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    MinHeight="38"
                                    Command="{Binding LoginCommand}"
                                    Content="{Binding LoginButtonText}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource AccentButton}" />
                                <Button
                                    Grid.Column="2"
                                    MinWidth="96"
                                    MinHeight="38"
                                    Command="{Binding ExitCommand}"
                                    Content="종료" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
