<UserControl x:Class="BH_CarLog.Views.Fuel.FuelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
             xmlns:common="clr-namespace:BH_CarLog.Views.Common"
             xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Fuel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FuelListViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:ListPageHeader Grid.Row="0" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  helpers:DataGridBehavior.RowDoubleClickCommand="{Binding UpdateCommand}"
                  helpers:DataGridBehavior.SelectRowOnRightClick="True"
                  helpers:DataGridBehavior.ScrollSelectionIntoView="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="추가" InputGestureText="Ins" Command="{Binding InsertCommand}" IsEnabled="{Binding Buttons.InsertEnabled}" />
                    <MenuItem Header="수정" InputGestureText="F8" Command="{Binding UpdateCommand}" IsEnabled="{Binding Buttons.UpdateEnabled}" />
                    <MenuItem Header="삭제" InputGestureText="Del" Command="{Binding DeleteCommand}" IsEnabled="{Binding Buttons.DeleteEnabled}" />
                    <Separator />
                    <MenuItem Header="갱신" InputGestureText="F5" Command="{Binding RefreshCommand}" IsEnabled="{Binding Buttons.RefreshEnabled}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!--  항목: FuelInfo  -->
                <DataGridTextColumn Header="주유일" Binding="{Binding refuel_at, Converter={StaticResource DateFmt}}" Width="100" ElementStyle="{StaticResource CenterCellText}" />
                <DataGridTextColumn Header="가게명" Binding="{Binding ShopName}" Width="1.6*" />
                <DataGridTextColumn Header="유종" Binding="{Binding fuel_type}" Width="70" ElementStyle="{StaticResource CenterCellText}" />
                <DataGridTextColumn Header="주행거리" Binding="{Binding mileage, StringFormat={}{0:#,0}}" Width="90" ElementStyle="{StaticResource RightCellText}" />
                <DataGridTextColumn Header="금액" Binding="{Binding amount, StringFormat={}{0:#,0}}" Width="90" ElementStyle="{StaticResource RightCellText}" />
                <DataGridTextColumn Header="\1ℓ" Binding="{Binding amount_per_liter, StringFormat={}{0:#,0}}" Width="70" ElementStyle="{StaticResource RightCellText}" />
                <DataGridTextColumn Header="수량(ℓ)" Binding="{Binding Liter, StringFormat={}{0:#,0.##}}" Width="75" ElementStyle="{StaticResource RightCellText}" />
                <DataGridTextColumn Header="연비" Binding="{Binding Efficiency, StringFormat={}{0:#,0.#}}" Width="65" ElementStyle="{StaticResource RightCellText}" />
                <DataGridTextColumn Header="비고" Binding="{Binding note}" Width="*" ElementStyle="{StaticResource MutedCellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
