<Window x:Class="BH_CarLog.Views.Shop.CarShopEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:common="clr-namespace:BH_CarLog.Views.Common"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.Shop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CarShopEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="600"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
        helpers:EnterNavigation.IsEnabled="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="기본 정보">
                <!--  오른쪽 라벨 폭을 RightLabel 그룹으로 맞춰 모든 줄의 입력란 좌우 경계가 같은 위치에 오게 한다.  -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="상호" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             helpers:FocusExtension.IsFocused="{Binding IsNameFocused}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource RequiredLabel}"><Run Text="사업자번호" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BusinessNo, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="12"
                                 FontFamily="{StaticResource MonoFont}"
                                 ToolTip="예: 123-45-67890" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RequiredLabel}" MinWidth="0"><Run Text="유형" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ShopTypes}" SelectedItem="{Binding SelectedShopType}" DisplayMemberPath="NmCode" Tag="가게 유형 선택" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="대표자" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Ceo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50" />

                    <TextBlock Grid.Row="3" Text="연락처" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Tel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                        <TextBlock Grid.Column="2" Text="추가연락처" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <TextBox Grid.Column="3" Text="{Binding Tel2, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="주소" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500" />
                </Grid>
            </GroupBox>

            <GroupBox Header="비고">
                <TextBox Style="{StaticResource MultilineTextBox}"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         MinHeight="60" />
            </GroupBox>

            <GroupBox Header="가게 이미지" Margin="0">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
