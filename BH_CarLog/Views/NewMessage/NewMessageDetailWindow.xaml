<Window x:Class="BH_CarLog.Views.NewMessage.NewMessageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_CarLog.Helpers"
        xmlns:common="clr-namespace:BH_CarLog.Views.Common"
        xmlns:vm="clr-namespace:BH_CarLog.ViewModels.NewMessage"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewMessageDetailViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="620"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <!--  웹 바로등록 한 건을 읽기 전용으로 보여 준다. 사진은 더블클릭으로 크게 볼 수 있다.  -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="실데이터 전환" Style="{StaticResource AccentButton}" Command="{Binding TransferCommand}" MinWidth="120" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="웹 등록 내용">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="차량" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding CarName, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="등록일" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <TextBox Grid.Column="3" IsReadOnly="True" Text="{Binding InputAtText, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="구분" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding TypeText, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="주행거리" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <TextBox Grid.Column="3" IsReadOnly="True" Text="{Binding MileageText, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="내용" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource MultilineTextBox}"
                             IsReadOnly="True"
                             Text="{Binding Note, Mode=OneWay}"
                             MinHeight="80"
                             Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Text="처리 상태" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding TransferText, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="웹 등록일시" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <TextBox Grid.Column="3" IsReadOnly="True" Text="{Binding CreatedAtText, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Header="첨부 사진" Margin="0">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
