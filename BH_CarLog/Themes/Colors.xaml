<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  테마 L1 "페이퍼 인디고" : 순백 바탕 + 남보라 포인트  -->

    <!--  배경  -->
    <Color x:Key="BgWindowColor">#FFFFFFFF</Color>
    <Color x:Key="BgPanelColor">#FFF5F6F8</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="BgInputColor">#FFFFFFFF</Color>
    <Color x:Key="BgHoverColor">#FFE9ECF1</Color>
    <Color x:Key="BgPressedColor">#FFDDE1E8</Color>
    <Color x:Key="GridHeaderColor">#FFEEF0F4</Color>
    <Color x:Key="RowAltColor">#FFFAFBFC</Color>

    <!--  테두리  -->
    <Color x:Key="BorderColor">#FFE1E4EA</Color>
    <Color x:Key="BorderLightColor">#FFC9CED8</Color>

    <!--  강조색  -->
    <Color x:Key="AccentColor">#FF4F5BD5</Color>
    <Color x:Key="AccentHoverColor">#FF3F4BC0</Color>
    <Color x:Key="AccentPressedColor">#FF3540A8</Color>
    <Color x:Key="AccentSoftColor">#FFE6E8FA</Color>
    <!--  캘린더 토요일 (일요일은 DangerColor)  -->
    <Color x:Key="SaturdayColor">#FF2F6BD9</Color>

    <!--  텍스트  -->
    <Color x:Key="TextColor">#FF1F2328</Color>
    <Color x:Key="TextMutedColor">#FF6B7280</Color>
    <Color x:Key="TextDisabledColor">#FFA3A9B5</Color>

    <!--  상태  -->
    <Color x:Key="DangerColor">#FFD9363E</Color>
    <Color x:Key="DangerSoftColor">#FFFDE8E9</Color>
    <Color x:Key="DangerTextColor">#FF9E1C24</Color>
    <Color x:Key="WarningColor">#FFC77700</Color>
    <Color x:Key="WarningSoftColor">#FFFFF1DB</Color>
    <Color x:Key="WarningTextColor">#FF8A5200</Color>
    <Color x:Key="SuccessColor">#FF1F8A5B</Color>
    <Color x:Key="SuccessSoftColor">#FFE4F5EC</Color>
    <Color x:Key="SuccessTextColor">#FF14603F</Color>

    <!--  스크롤 / 오버레이  -->
    <Color x:Key="ScrollThumbColor">#FFC9CED8</Color>
    <Color x:Key="ScrollThumbHoverColor">#FFAEB5C2</Color>
    <Color x:Key="HoverOverlayColor">#FF000000</Color>
    <Color x:Key="DisabledOverlayColor">#80FFFFFF</Color>

    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource BgWindowColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgPressedBrush" Color="{StaticResource BgPressedColor}" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="{StaticResource GridHeaderColor}" />
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SaturdayBrush" Color="{StaticResource SaturdayColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="DisabledOverlayBrush" Color="{StaticResource DisabledOverlayColor}" />

    <FontFamily x:Key="AppFont">Malgun Gothic, 맑은 고딕, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, D2Coding, Courier New</FontFamily>

</ResourceDictionary>
